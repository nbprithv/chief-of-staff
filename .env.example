# Server
PORT=3000
NODE_ENV=development

# PocketBase
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@assistant.local
PB_ADMIN_PASSWORD=changeme_local_only

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback
GOOGLE_REFRESH_TOKEN=
GMAIL_LABEL=INBOX

# Cron jobs (Vercel)
# CRON_SECRET is set automatically by Vercel; copy the value here for local testing
CRON_SECRET=
# The Google account email address used to authenticate cron sync jobs
CRON_USER_ID=