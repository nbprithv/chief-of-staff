{
  "version": 2,
  "buildCommand": "echo 'migrations run at startup'",
  "ignoreCommand": "exit 0",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "drizzle/**", "data/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/cron/school-email-digest",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/weeknight-meal-planner",
      "schedule": "0 13 * * 6"
    }
  ]
}
